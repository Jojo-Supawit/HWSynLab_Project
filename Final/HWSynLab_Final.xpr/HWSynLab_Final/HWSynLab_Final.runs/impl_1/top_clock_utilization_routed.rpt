# Location of BUFG Primitives 
set_property LOC BUFGCTRL_X0Y3 [get_cells sccb_clk_BUFG_inst]
set_property LOC BUFGCTRL_X0Y2 [get_cells dbg_hub/inst/BSCANID.u_xsdbm_id/SWITCH_N_EXT_BSCAN.u_bufg_icon_tck]
set_property LOC BUFGCTRL_X0Y4 [get_cells clk_wiz/inst/clkf_buf]
set_property LOC BUFGCTRL_X0Y1 [get_cells clk_wiz/inst/clkout2_buf]
set_property LOC BUFGCTRL_X0Y0 [get_cells clk_wiz/inst/clkout1_buf]
set_property LOC BUFGCTRL_X0Y16 [get_cells camera_pclk_IBUF_BUFG_inst]

# Location of IO Primitives which is load of clock spine
set_property LOC IOB_X0Y128 [get_cells camera_xclk_OBUF_inst]

# Location of clock ports
set_property LOC IOB_X0Y126 [get_ports camera_pclk]
set_property LOC IOB_X1Y26 [get_ports clk]

# Clock net "sccb_clk_BUFG" driven by instance "sccb_clk_BUFG_inst" located at site "BUFGCTRL_X0Y3"
#startgroup
create_pblock {CLKAG_sccb_clk_BUFG}
